# Copy to .env and adjust. Never commit real secrets.

# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:8080/api

# true = log in without a backend using a locally generated mock token (development only)
VITE_USE_MOCK_AUTH=true

# true = data hooks (dashboard, packages…) return mock data instead of calling the API (development only)
VITE_USE_MOCK_API=true
