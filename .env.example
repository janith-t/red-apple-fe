# Reference of every environment variable the app reads. Never commit real secrets.
#
# Development: nothing to do – `npm run dev` loads .env.development (mock mode).
#   Personal overrides → .env.development.local
# Production build: provide these via .env.production / your CI or hosting settings.

# Base URL of the backend REST API (required when mock flags are off)
VITE_API_BASE_URL=https://api.example.com/api

# true = log in without a backend using a locally generated mock token (development only)
VITE_USE_MOCK_AUTH=false

# true = data hooks (dashboard, packages…) return mock data instead of calling the API (development only)
VITE_USE_MOCK_API=false
