# Shared development defaults, loaded automatically by `npm run dev` (committed – no secrets here).
# To override on your machine, create .env.development.local (gitignored); it takes priority over this file.

# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:8080/api

# true = log in without a backend using a locally generated mock token
VITE_USE_MOCK_AUTH=true

# true = data hooks (dashboard, packages…) return mock data instead of calling the API
VITE_USE_MOCK_API=true
